# Copiá este archivo a .env y completá los valores antes de `docker compose up`.

# Base de datos
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=flowdesk
MYSQL_USER=flowdesk
MYSQL_PASSWORD=changeme_db

# WordPress
WORDPRESS_TABLE_PREFIX=fd_
WP_URL=http://localhost:8080
WP_TITLE=FlowDesk
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme_admin
WP_ADMIN_EMAIL=admin@example.com

# Newsletter (notificación admin al llegar un suscriptor nuevo)
NEWSLETTER_NOTIFY_EMAIL=admin@example.com
